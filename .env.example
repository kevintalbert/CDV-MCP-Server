# Required: CDV instance URL and admin API key
CDV_BASE_URL=https://your-cdv-instance.cloudera.site/
CDV_API_KEY=your_cdv_api_key_here

# Required for visual shelf configuration (creates/saves chart column assignments).
# Without these, create_smart_visual will create visual skeletons only — charts will
# render blank and throw "TypeError: Cannot read properties of undefined (reading
# 'toUpperCase')" in CDV's frontend.
CDV_USERNAME=vizapps_admin
CDV_PASSWORD=vizapps_admin
